{
    "name": "feryardiant/learn-monorepo",
    "description": "Laravel Package Template",
    "keywords": [
        "laravel",
        "package",
        "template"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Fery Wardiyanto",
            "email": "ferywardiyanto@gmail.com"
        }
    ],
    "support": {
        "source": "https://github.com/feryardiant/learn-monorepo"
    },
    "scripts": {
        "lint": [
            "@php vendor/bin/pint",
            "@php vendor/bin/phpstan analyse"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench serve"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/pest --coverage"
        ],
        "testbench": [
            "@php vendor/bin/testbench"
        ],
        "tinker": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench tinker"
        ]
    },
    "autoload": {
        "psr-4": {
            "LearnMonorepo\\": [
                "packages/common/src",
                "packages/foo/src",
                "packages/bar/src"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LearnMonorepo\\Tests\\": "tests",
            "Workbench\\": "workbench"
        }
    },
    "require": {
        "php": ">=8.3",
        "laravel/framework": "^v13.37"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "nunomaduro/collision": "^8.9",
        "orchestra/pest-plugin-testbench": "^4.1",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^4.7",
        "symplify/monorepo-builder": "^12.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "LearnMonorepo\\BarServiceProvider",
                "LearnMonorepo\\CommonServiceProvider",
                "LearnMonorepo\\FooServiceProvider"
            ]
        }
    },
    "replace": {
        "feryardiant/learn-monorepo-bar": "self.version",
        "feryardiant/learn-monorepo-common": "self.version",
        "feryardiant/learn-monorepo-foo": "self.version"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
