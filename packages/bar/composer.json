{
    "name": "feryardiant/learn-monorepo-bar",
    "description": "Dummy package to learn monorepo, DO NOT USE!",
    "keywords": ["laravel", "package"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Fery Wardiyanto",
            "email": "ferywardiyanto@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/feryardiant/learn-monorepo/issues"
    },
    "autoload": {
        "psr-4": {
            "LearnMonorepo\\": "src"
        }
    },
    "require": {
        "php": ">=8.3",
        "laravel/framework": "^v13.37",
        "feryardiant/learn-monorepo-common": "self.version"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "LearnMonorepo\\BarServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
